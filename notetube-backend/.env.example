PORT=8787
DATABASE_URL=postgres://notetube:notetube@localhost:5432/notetube
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=                      # 32+ random bytes: openssl rand -hex 32
SESSION_DAYS=30
GOOGLE_CLIENT_ID=                    # same value as the frontend's VITE_GOOGLE_CLIENT_ID
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash        # verify at ai.google.dev/gemini-api/docs/models (ids rotate)
YOUTUBE_API_KEY=
DAILY_GENERATION_LIMIT=5
MAX_VIDEO_MINUTES=240

# optional
NODE_ENV=development
TRUST_PROXY=false                    # set true behind Render/Railway/nginx so per-IP limits see real client IPs
WORKER_CONCURRENCY=2
GEMINI_MAX_RPM=10                    # project-wide cap, the free tier is per project, not per user
LOG_LEVEL=info
