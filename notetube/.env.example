# Frontend (Vite). Copy to .env.local
# API base. Leave unset to use /api, which `npm run dev` proxies to the backend.
# VITE_API_URL=
# Where the dev proxy sends /api (default http://localhost:8787)
# VITE_API_PROXY=http://localhost:8787
# Google OAuth Web client id. Without it the Google button explains how to set it up.
# VITE_GOOGLE_CLIENT_ID=
